# Vorlage fuer .env — Datei kopieren nach `.env`, die echte .env ist gitignored.
#
# WICHTIG: Waehrend der gesamten Entwicklung bleiben die Google-Test-IDs stehen.
# Echte IDs werden ausschliesslich fuer Release-Builds gesetzt (lokal in .env oder
# als GitHub-Secret im Workflow android-release.yml).
#
# Ein Klick auf eine echte Anzeige im eigenen Testgeraet gilt als ungueltiger
# Traffic und kann das AdMob-Konto sperren. Deshalb: nie mit echten IDs testen.

# --- AdMob App-ID -----------------------------------------------------------
# Diese ID ist KEINE Laufzeitgroesse: sie muss im AndroidManifest stehen.
# `npm run android:prepare` schreibt sie ueber scripts/inject-admob-appid.ts in
# eine Android-Ressource, das Manifest referenziert nur diese Ressource.
# Der hier eingetragene Wert ist Googles offizielle Test-App-ID.
ADMOB_APP_ID=

# --- Ad-Unit-IDs ------------------------------------------------------------
# Diese gehen ueber import.meta.env in den Web-Bundle.
# Leer lassen = der AdService benutzt automatisch die Google-Test-Unit-IDs.
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_REWARDED_ID=

# --- Ad-Verhalten -----------------------------------------------------------
# true = Testanzeigen anfordern (isTesting). Fuer Releases auf false setzen.
VITE_ADMOB_TESTING=true

# Kommagetrennte Geraete-IDs, die als Testgeraete registriert werden.
# Die ID steht beim ersten Start im Logcat ("Use RequestConfiguration...").
VITE_ADMOB_TEST_DEVICES=

# Erzwingt im Debug-Build eine bestimmte Consent-Region zum Testen des
# UMP-Formulars: EEA | OTHER | DISABLED
# (OTHER = ausserhalb der EEA; der fruehere Wert NOT_EEA ist veraltet.)
VITE_ADMOB_DEBUG_GEOGRAPHY=DISABLED
